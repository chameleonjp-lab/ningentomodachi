{
  "name": "ningentomodachi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "format": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
