    "test:contracts": "vitest run tests/contracts",
    "test:core": "vitest run tests/core",
    "test:unit": "vitest run --exclude 'tests/contracts/**' --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
