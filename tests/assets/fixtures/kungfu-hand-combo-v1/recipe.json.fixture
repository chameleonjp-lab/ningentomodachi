    "{\n  \"schemaVersion\": 1,\n  \"status\": \"fixed-source-only-recipe-proposal\",\n  \"acceptance\": null,\n  \"gameplayAllowance\": null,\n  \"clipId\": \"KungFuHandCombo5\",\n  \"sourceClipPointer\": \"/clips/12\",\n  \"sourceSha256\": \"c5dd6733fc1ba208cb90b4a556dc8e0b05964d6c49e330d09220ade9b991d95d\",\n  \"sourceManifestClip\": {\n    \"clip\": \"KungFuHandCombo5\",\n    \"name_ja\": \"中国拳法・手技5連撃\",\n    \"sheet\": \"S5\",\n    \"source_section\": null,\n    \"fps\": 45,\n    \"source_frame_range\": [\n      1,\n      145\n    ],\n    \"seconds\": 3.1999999999999997,\n    \"loop\": false,\n    \"net_root_blender_m\": [\n      5.476568087914302e-09,\n      -0.1600000262260437,\n      -2.9802322387695312e-08\n    ],\n    \"net_root_gltf_world_basis_m\": [\n      5.476568087914302e-09,\n      -2.9802322387695312e-08,\n      0.1600000262260437\n    ],\n    \"root_motion\": {\n      \"root_motion\": {\n        \"policy\": \"Non-looping 0.16 m net forward Blender -Y / glTF +Z. Low pelvis weights and yaws through chain, retains final advanced location. No origin snap at recovery. Gameplay must retain or extract net translation.\",\n        \"net_yaw_rad\": 0\n      }\n    },\n    \"support_contacts\": {\n      \"support_contacts\": [\n        {\n          \"bone\": \"foot.R\",\n          \"frames\": [\n            1,\n            145\n          ],\n          \"ankle_armature_m\": [\n            -0.39,\n            0.19,\n            0.168\n          ],\n          \"description\": \"rear support fixed throughout\"\n        },\n        {\n          \"bone\": \"foot.L\",\n          \"frames\": [\n            1,\n            5\n          ],\n          \"ankle_armature_m\": [\n            0.37,\n            -0.13,\n            0.168\n          ]\n        },\n        {\n          \"bone\": \"foot.L\",\n          \"frames\": [\n            6,\n            16\n          ],\n          \"description\": \"small lifted lead-foot advance; rear foot remains support\"\n        },\n        {\n          \"bone\": \"foot.L\",\n          \"frames\": [\n            17,\n            145\n          ],\n          \"ankle_armature_m\": [\n            0.4,\n            -0.27,\n            0.168\n          ],\n          \"description\": \"lead support planted after step\"\n        }\n      ]\n    },\n    \"attack_and_timeline_events\": {\n      \"attack_events\": [\n        {\n          \"frame\": 22,\n          \"type\": \"沖拳 / straight punch\",\n          \"side\": \"R\",\n          \"surface\": \"closed fist\",\n          \"direction\": \"forward -Y\",\n          \"count\": 1\n        },\n        {\n          \"frame\": 43,\n          \"type\": \"推掌 / palm heel\",\n          \"side\": \"L\",\n          \"surface\": \"open upright palm heel\",\n          \"direction\": \"forward -Y\",\n          \"count\": 1\n        },\n        {\n          \"frame\": 66,\n          \"type\": \"鞭拳 / whipping backfist\",\n          \"side\": \"R\",\n          \"surface\": \"dorsal closed fist\",\n          \"direction\": \"horizontal center-to-right arc (-X)\",\n          \"count\": 1\n        },\n        {\n          \"frame\": 87,\n          \"type\": \"肘打 / elbow\",\n          \"side\": \"R\",\n          \"surface\": \"elbow, fist beside same-side head\",\n          \"direction\": \"close forward/up, -Y/+Z\",\n          \"count\": 1\n        },\n        {\n          \"frame\": 108,\n          \"type\": \"追掌 / follow-up palm\",\n          \"side\": \"L\",\n          \"surface\": \"open upright palm heel\",\n          \"direction\": \"forward -Y\",\n          \"count\": 1\n        }\n      ]\n    },\n    \"phases\": {\n      \"phases\": [\n        {\n          \"name\": \"ready/load and lead-foot advance\",\n          \"frames\": [\n            1,\n            17\n          ]\n        },\n        {\n          \"name\": \"straight punch\",\n          \"frames\": [\n            18,\n            27\n          ]\n        },\n        {\n          \"name\": \"continuous palm drive\",\n          \"frames\": [\n            28,\n            46\n          ]\n        },\n        {\n          \"name\": \"cross-body load, backfist whip and follow-through\",\n          \"frames\": [\n            47,\n            73\n          ]\n        },\n        {\n          \"name\": \"fold into rising close elbow\",\n          \"frames\": [\n            74,\n            93\n          ]\n        },\n        {\n          \"name\": \"immediate open follow-up palm\",\n          \"frames\": [\n            94,\n            114\n          ]\n        },\n        {\n          \"name\": \"controlled guard recovery\",\n          \"frames\": [\n            115,\n            145\n          ]\n        }\n      ]\n    },\n    \"start_end_use\": \"Starts low broad combat guard; ends low broad advanced guard after lead step and retained 0.16 m root advance. Blend from guard, not Idle. Extract root travel once if using root motion.\",\n    \"primary_category\": \"punch\",\n    \"secondary_tags\": [\n      \"combo\",\n      \"palm\",\n      \"elbow\"\n    ],\n    \"original_source_fps\": 30,\n    \"source_prose_warning\": \"元資料1.0倍速の説明文です。本文中の秒数は2/3倍、秒単位の速度は1.5倍に換算してください。フレーム番号・距離・角度は不変。併記の数値フィールドはすでに1.5倍速用に換算済みです。重力など物理設定は元資料の注釈であり、1.5倍速版を再シミュレーションする設定ではありません。\"\n  },\n  \"sourceTimesSeconds\": [\n    0.02222222276031971,\n    0.04444444552063942,\n    0.06666667014360428,\n    0.08888889104127884,\n    0.1111111119389534,\n    0.13333334028720856,\n    0.15555556118488312,\n    0.17777778208255768,\n    0.20000000298023224,\n    0.2222222238779068,\n    0.24444444477558136,\n    0.2666666805744171,\n    0.2888889014720917,\n    0.31111112236976624,\n    0.3333333432674408,\n    0.35555556416511536,\n    0.3777777850627899,\n    0.4000000059604645,\n    0.42222222685813904,\n    0.4444444477558136,\n    0.46666666865348816,\n    0.4888888895511627,\n    0.5111110806465149,\n    0.5333333611488342,\n    0.555555522441864,\n    0.5777778029441833,\n    0.599999964237213