    "sourceRoot": {
      "root_motion": "Left ankle remains at Blender (0.22,0.035,0.146) world m. Root translates in XY to place the pelvis over the left-foot pivot during deep support, with torso counterbalance against the long sweeping leg. Body yaw winds to -0.46 rad, then turns continuously to +2.40 rad and retains this new heading. During recovery the right foot plants at frame 64 before weight returns to the two-foot stance around the new orientation. Final root travel is retained, approximately (+0.406, -0.088, 0) m in Blender space. No terminal heading or position teleport. Use authored root yaw, not an in-place loop."
    },
    "sourceSupport": {
      "support_contacts": [
        {
          "limb": "left foot",
          "frames": [
            1,
            78
          ],
          "description": "Continuous grounded support. Flat sole, anchored ankle, pivoting yaw; deeply flexed supporting knee during frames 19-50."
        },
        {
          "limb": "right foot",
          "frames": [
            1,
            10
          ],
          "description": "Remains grounded during the initial weight shift to left support; only then lifts into chamber."
        },
        {
          "limb": "right foot",
          "frames": [
            64,
            78
          ],
          "description": "Re-establishes second-foot contact at the new heading before shifting weight and rising. Holds stance contact through recovery."
        }
      ]
    },
    "sourcePhases": {
      "phase_frames": {
        "startup": 1,
        "grounded_weight_transfer": 10,
        "sink_chamber": 19,
        "low_extension": 26,
        "sweep_midpoint": 35,
        "sweep_end": 44,
        "follow_through": 50,
        "second_foot_plant": 64,
        "recovery": 78
      }
    },
    "sourceStartEndUse": "Guard to turned guard. One-shot with retained 2.40 rad heading. Blend from final orientation or extract root yaw into actor transform; never reset root rotation without compensating actor orientation.",
